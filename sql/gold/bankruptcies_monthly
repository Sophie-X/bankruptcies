CREATE SCHEMA IF NOT EXISTS gold;
CREATE OR REPLACE VIEW gold.bankruptcies_monthly_sbi_1
AS 
SELECT
    b.type_key                                                              AS type_key,
    t.type_title                                                            AS type_title,   
    t.type_description                                                      AS type_description, 
    b.sector_key                                                            AS sector_key,
    s.sector_title                                                          AS sector_title,
    s.level_name                                                            AS level_name,
    b.period_key                                                            AS period_key,
    p.period_type                                                           AS period_type,
    p.period_date                                                           AS period_date,
    p.period_status                                                         AS period_status,
    p.is_provisional                                                        AS is_provisional,
    b.bankruptcies                                                          AS bankruptcies
FROM silver.fact_bankruptcies b
INNER JOIN silver.dim_periods p
ON b.period_key = p.period_key
INNER JOIN silver.dim_typesofbankruptcies t
ON t.type_key = b.type_key
INNER JOIN silver.dim_sectors s
ON s.sector_key = b.sector_key
WHERE p.period_type = 'MM' AND s.level_name = 'sbi_1';
